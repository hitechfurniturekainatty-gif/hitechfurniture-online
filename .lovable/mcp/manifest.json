{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://thwleiywbpyccgtacczv.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "my-hitech",
      "version": "0.1.0",
      "title": "My Hitech"
    },
    "tools": [
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search the furniture catalog by name or product code and return pricing and stock details.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Product name or code to search for."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "Maximum number of products to return."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "low_stock_products",
        "title": "Low stock products",
        "description": "List catalog products whose stock quantity is at or below their reorder level.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum number of products to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_quotations",
        "title": "List quotations",
        "description": "List recent quotations and orders, optionally filtered by pipeline stage, status, or customer name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "description": "Pipeline stage 1-6 to filter by."
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "description": "Status filter, e.g. draft, finalized, delivered."
            },
            "party": {
              "type": "string",
              "minLength": 1,
              "description": "Customer/party name to search for."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum number of rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_quotation",
        "title": "Get quotation",
        "description": "Fetch one quotation with its line items, using its human-readable quotation code (e.g. QT-1024).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "quotation_code": {
              "type": "string",
              "minLength": 1,
              "description": "The quotation code shown on the document."
            }
          },
          "required": [
            "quotation_code"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_open_enquiries",
        "title": "List open enquiries",
        "description": "List unresolved customer complaints and service/repair requests from the enquiries inbox.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "all",
                "complaint",
                "service"
              ],
              "default": "all",
              "description": "Which enquiry type to list."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum rows per type."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "resolve_enquiry",
        "title": "Mark enquiry resolved",
        "description": "Mark a customer complaint or service request as resolved, using its complaint or service code.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "complaint",
                "service"
              ],
              "description": "Whether the code belongs to a complaint or a service request."
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "description": "The complaint code or service code."
            }
          },
          "required": [
            "kind",
            "code"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
