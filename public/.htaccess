# Hostinger / Apache SPA fallback for React Router
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Dynamic rendering for crawlers that don't execute JavaScript ---
  # GPTBot/ClaudeBot/PerplexityBot/Google-Extended/CCBot etc. feed AI answer
  # engines (ChatGPT, Claude, Perplexity, Google AI Overview) but never run the
  # React app's JS, so they'd otherwise see an empty <div id="root">. Route
  # them to the pre-generated static snapshots in /_snapshots instead. Real
  # browsers and JS-executing crawlers (Googlebot, Bingbot) are unaffected.
  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|CCBot|OAI-SearchBot|ChatGPT-User|Applebot-Extended|Bytespider|Diffbot|omgili) [NC]
  RewriteCond %{REQUEST_URI} ^/$
  RewriteRule ^$ /_snapshots/index.html [L]

  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|CCBot|OAI-SearchBot|ChatGPT-User|Applebot-Extended|Bytespider|Diffbot|omgili) [NC]
  RewriteCond %{REQUEST_URI} ^/catalog/?$
  RewriteRule ^ /_snapshots/catalog.html [L]

  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|CCBot|OAI-SearchBot|ChatGPT-User|Applebot-Extended|Bytespider|Diffbot|omgili) [NC]
  RewriteCond %{REQUEST_URI} ^/about/?$
  RewriteRule ^ /_snapshots/about.html [L]

  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|CCBot|OAI-SearchBot|ChatGPT-User|Applebot-Extended|Bytespider|Diffbot|omgili) [NC]
  RewriteCond %{REQUEST_URI} ^/faq/?$
  RewriteRule ^ /_snapshots/faq.html [L]

  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|CCBot|OAI-SearchBot|ChatGPT-User|Applebot-Extended|Bytespider|Diffbot|omgili) [NC]
  RewriteCond %{REQUEST_URI} ^/product/([0-9a-fA-F-]+)/?$
  RewriteRule ^ /_snapshots/product/%1.html [L]

  RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|CCBot|OAI-SearchBot|ChatGPT-User|Applebot-Extended|Bytespider|Diffbot|omgili) [NC]
  RewriteCond %{REQUEST_URI} ^/bundle/([0-9a-fA-F-]+)/?$
  RewriteRule ^ /_snapshots/bundle/%1.html [L]

  # Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send everything else to index.html so React Router can handle it
  RewriteRule ^ index.html [L]
</IfModule>

# Cache hashed assets aggressively, never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
